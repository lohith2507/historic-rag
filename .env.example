OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: model used to draw the animated scene. Defaults to OPENROUTER_CHAT_MODEL.
OPENROUTER_SCENE_MODEL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Pollinations account token. Without it images are watermarked and rate limited to 1 req/15s.
# Register free at https://auth.pollinations.ai to remove the watermark.
POLLINATIONS_TOKEN=
# Optional: secret used to sign illustration proxy URLs. Falls back to OPENROUTER_API_KEY.
ILLUSTRATION_SECRET=
